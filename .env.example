# Public frontend settings only. Never put Zoom client secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_ZOOM_SDK_VERSION=0.16

# Supabase (live bid sync). URL and anon key are safe for the browser;
# the service role key is server-only and must never be exposed client-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Identity (server only). ZOOM_CLIENT_SECRET comes from the Marketplace app
# credentials (Development for the tunnel, Production for the live app).
# SESSION_SECRET signs the identity cookie: openssl rand -base64 32
ZOOM_CLIENT_SECRET=your-zoom-client-secret
SESSION_SECRET=your-random-session-secret

# Zoom event subscription Secret Token (Marketplace app > Features > Access).
# Verifies meeting.started webhooks, which set the real meeting host.
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token
